# Скопируйте в .env и заполните. Реальные секреты не коммитить.

# Строка подключения к PostgreSQL (драйвер asyncpg).
# В docker compose переопределяется на хост `db`.
DATABASE_URL=postgresql+asyncpg://fellow:fellow@localhost:5434/fellow_travelers

# БД для тестов (по умолчанию как ниже; тесты создают её сами).
# TEST_DATABASE_URL=postgresql+asyncpg://fellow:fellow@localhost:5434/fellow_travelers_test

# Токен Telegram-бота (от @BotFather); используется для проверки initData.
BOT_TOKEN=change-me

# Username бота без @.
BOT_USERNAME=your_bot

# Максимальный возраст initData, секунды (по умолчанию сутки).
INIT_DATA_MAX_AGE_SECONDS=86400

# Режим отладки (true/false).
DEBUG=false
