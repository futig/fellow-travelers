# Базовый URL API. По умолчанию /api/v1 (в dev проксируется на localhost:8000, в проде — nginx).
VITE_API_BASE=/api/v1

# Username бота без @ — для кнопки «Поделиться номером», если requestContact недоступен.
VITE_BOT_USERNAME=

# Только dev: имитировать окружение Telegram (фейковые user и initData) в обычном браузере.
VITE_MOCK_TELEGRAM=false

# Вместо сети отдавать фиктивный профиль (GET /me).
VITE_MOCK_API=false

# Вместе с VITE_MOCK_API=true: профиль без телефона (проверка состояния has_phone=false).
VITE_MOCK_NO_PHONE=false
